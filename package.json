{
  "name": "luna-mission",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter \"@luna/api\" dev & bun --filter \"@luna/web\" dev",
    "dev:web": "bun --filter \"@luna/web\" dev",
    "dev:api": "bun --filter \"@luna/api\" dev",
    "build": "bun --filter \"@luna/web\" build && bun --filter \"@luna/api\" build",
    "preview": "bun --filter \"@luna/web\" preview",
    "test": "bun test",
    "test:e2e": "bun test --path-ignore-patterns=\"_archive\" apps/web/test/m6_browser_viewport_qa.test.ts apps/web/test/challenger_m6_viewport_stress.test.ts",
    "typecheck": "tsc --noEmit",
    "perf:scenario": "bun run tooling/measure-scenario-latency.ts",
    "lint": "tsc --noEmit",
    "ask:deepseek": "bun run tooling/scripts/deepseek-bridge.ts",
    "clean": "rm -rf dist apps/*/dist"
  },
  "devDependencies": {
    "@nextrush/adapter-bun": "^1.1.0",
    "@nextrush/core": "^4.1.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "lucide-react": "^0.546.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "typescript": "^5.8.2",
    "zod": "^4.6.7"
  }
}